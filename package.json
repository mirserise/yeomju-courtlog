{
  "name": "yeomju-courtlog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npx --yes netlify-cli@latest dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:live": "tsx scripts/test-live-scrape.ts",
    "seed:prepare": "tsx scripts/prepare-seed.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.0",
    "@netlify/functions": "^6.0.3",
    "@netlify/identity": "^2.0.0",
    "cheerio": "^1.1.2",
    "date-holidays": "^3.26.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "rollup": "^4.59.0"
  }
}
